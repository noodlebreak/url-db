#!/bin/bash
# When index.html has staged changes vs HEAD, bump vX.Y in the header (minor +1).
# Uses git diff --cached HEAD (not --name-only) so we catch real content changes;
# plain "git add index.html" when unchanged does not trigger a bump.

FILE="index.html"

if [ -z "$(git diff --cached HEAD -- "$FILE" 2>/dev/null)" ]; then
  exit 0
fi

CURRENT=$(grep -oE 'v[0-9]+\.[0-9]+' "$FILE" | head -1 | sed 's/^v//')
if [ -z "$CURRENT" ]; then
  exit 0
fi

MAJOR=$(echo "$CURRENT" | cut -d. -f1)
MINOR=$(echo "$CURRENT" | cut -d. -f2)
NEW_MINOR=$((MINOR + 1))
NEW_VERSION="${MAJOR}.${NEW_MINOR}"

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
sed "s/v${CURRENT}/v${NEW_VERSION}/g" "$FILE" > "$tmp" && mv "$tmp" "$FILE"
trap - EXIT

git add "$FILE"
